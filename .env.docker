# Docker Compose *variable substitution* file for LOCAL DEVELOPMENT ONLY —
# these are the ${VAR} values compose.yaml/compose.override.yaml interpolate,
# not the Symfony app's own config (that's .env, loaded by Symfony itself).
#
# Loaded explicitly via `docker compose --env-file .env.docker ...` (see the
# Makefile) so it never mixes with the app's .env. Safe to commit: every value
# here is a throwaway dev default.
#
# Production must NOT use this file. Export the real values
# (COMPOSE_APP_SECRET, COMPOSE_MAILER_DSN, POSTGRES_PASSWORD, ...) as real
# environment variables from your CI/host secrets store before running
# `make prod-up` — compose.yaml has no defaults for those on purpose, so a
# forgotten secret fails the deploy instead of silently running with a dev
# value. The COMPOSE_ prefix (rather than plain APP_SECRET/MAILER_DSN) is
# deliberate — see the comment at the top of compose.yaml.

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!

COMPOSE_APP_SECRET=f25d95b8189c1efe02456eac28bc5d51
COMPOSE_MAILER_DSN=smtp://mailer:1025

HTTP_PORT=8080
